{
  "name": "@localseodata/mcp-server",
  "version": "1.5.0",
  "description": "Model Context Protocol (MCP) server for Local SEO Data: 55 local SEO data tools for AI assistants.",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.github.localseodata/mcp-server",
  "main": "dist/index.js",
  "files": [
